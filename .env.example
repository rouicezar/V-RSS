# Docker Compose 配置：复制为根目录 .env
# cp .env.example .env

# 必填：管理界面授权码，至少 12 位，不要使用 changeme/123456/password
AUTH_CODE=

# 必填：账号 token 加密密钥，建议执行 openssl rand -hex 32
ENCRYPTION_KEY=

# 外部访问地址；反向代理使用 HTTPS 时填写 https://你的域名
SERVER_ORIGIN_URL=http://localhost:4000

# 方案1的 .xyz 服务地址；不用方案1也可保留
PLATFORM_URL=https://weread.111965.xyz

# 可选：AI 分析功能
DEEPSEEK_API_KEY=

MAX_REQUEST_PER_MINUTE=60
UPDATE_DELAY_TIME=60
