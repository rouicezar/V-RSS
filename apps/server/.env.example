# ============================================
# V-RSS 服务端配置模板
# 复制为 apps/server/.env 后按需修改
#   cp apps/server/.env.example apps/server/.env
# ============================================

# 服务监听地址与端口
HOST=0.0.0.0
PORT=4000

# ---------- 数据库 ----------
# SQLite（默认，最简单，适合个人使用）
DATABASE_URL="file:../data/vrss.db"
DATABASE_TYPE="sqlite"

# MySQL（生产推荐，多用户/大数据量时使用）
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/vrss"
# DATABASE_TYPE="mysql"

# ---------- 访问授权码 ----------
# 访问管理界面所需的密码（重要：设置一个自己的密码！）
# 留空则不需要登录，任何人都能访问（不建议）
AUTH_CODE=changeme

# ---------- 接口限流 ----------
# 每分钟最大请求次数，防止被微信封控
MAX_REQUEST_PER_MINUTE=60

# ---------- RSS 输出 ----------
# 自动提取全文内容（生成 RSS 时抓取正文全文）
FEED_MODE="fulltext"

# 服务端访问地址（部署到公网时填写域名或 IP，用于生成完整的 RSS 链接）
SERVER_ORIGIN_URL=http://localhost:4000

# 定时更新订阅源 Cron 表达式（每天 5:35 和 17:35 自动同步）
CRON_EXPRESSION="35 5,17 * * *"

# 是否开启正文 html 清理
ENABLE_CLEAN_HTML=true

# 连续更新延迟时间（秒），减少被微信限流的风险
UPDATE_DELAY_TIME=60

# ---------- AI 分析（DeepSeek）----------
# 用于：文章自动打标签、雷达分析报告、学习计划生成
# 没有则 AI 功能不可用，其余功能正常
DEEPSEEK_API_KEY=

# ---------- 微信读书接口中转（一般不需要改）----------
PLATFORM_URL="https://weread.111965.xyz"
